/* _tokens.uss
   Jade & Silver theme — token variables for The Waning Border HUD.
   Ported from Game HUD/themes.jsx (jade entry). Applied via the .tw-theme-jade
   class on the document root so future themes can swap by class.
   Keep this file ordered: palette → terrain → typography → spacing. */

.tw-theme-jade {
    /* ─── Palette ───────────────────────────────────────────────────────── */
    --tw-bg:            #06100d;   /* viewport background */
    --tw-base:          #0b1f1a;   /* panel deep */
    --tw-base-mid:      #143228;   /* panel mid (radial highlight in mockup) */
    --tw-base-edge:     #04100b;   /* panel outer */

    --tw-inlay:         #cfd6d3;   /* filigree silver */
    --tw-inlay-dim:     #7f8e8a;
    --tw-inlay-shadow:  #020806;

    --tw-accent:        #e8b84a;   /* gold default */
    --tw-accent-soft:   #8a6a1f;

    --tw-text:          #e6efea;
    --tw-text-dim:      rgba(207, 214, 211, 0.6);

    --tw-gem:           #1d6a55;   /* crystal facet */
    --tw-gem-hi:        #3fbf9a;

    /* ─── Terrain (minimap, Phase 2) ────────────────────────────────────── */
    --tw-terrain-grass:      #1a3d2c;
    --tw-terrain-grass-dk:   #102a1f;
    --tw-terrain-forest:     #0d2418;
    --tw-terrain-forest-dk:  #071810;
    --tw-terrain-water:      #0c2a3a;
    --tw-terrain-water-dk:   #061a26;
    --tw-terrain-mountain:   #3a3a36;
    --tw-terrain-mountain-dk:#23231f;
    --tw-terrain-sand:       #5a4a30;

    /* ─── Typography ────────────────────────────────────────────────────── */
    /* Display = Cinzel-equivalent (caps, wide tracking). Body = Cormorant-equivalent.
       Real font assets land in Phase 1 (Assets/UI/Fonts/). For Phase 0 these
       fall through to Unity's default font. */
    --tw-letter-tight:   2px;
    --tw-letter-wide:    4px;
    --tw-letter-xwide:   8px;

    --tw-font-eyebrow:   10px;
    --tw-font-label:     11px;
    --tw-font-body:      13px;
    --tw-font-value:     15px;
    --tw-font-title:     20px;

    /* ─── Spacing ───────────────────────────────────────────────────────── */
    --tw-pad-panel-x:    18px;
    --tw-pad-panel-y:    14px;
    --tw-pad-button-x:   14px;
    --tw-pad-button-y:   10px;
    --tw-gap-tight:      4px;
    --tw-gap-row:        8px;
    --tw-gap-section:    14px;

    /* ─── Chamfer / corner radius ───────────────────────────────────────── */
    /* USS lacks clip-path: polygon, so Phase 0 uses border-radius. Phase 1
       swaps to a 9-slice SVG plate authored at Assets/UI/Vectors/plate.svg. */
    --tw-radius-sm:      4px;
    --tw-radius-md:      6px;
    --tw-radius-lg:      10px;

    /* ─── Surface opacity / overlay ─────────────────────────────────────── */
    --tw-overlay-dim:    rgba(0, 0, 0, 0.55);
}
