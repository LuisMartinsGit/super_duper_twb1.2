/* _widgets.uss
   Composite signature widgets — sigil icons, medallion, minimap diamond frame.
   Each class binds a SVG from Assets/UI/Vectors/ to a sized VisualElement so
   callers compose them into UXML without per-element vector wiring.

   Usage:
     <ui:VisualElement class="tw-sigil tw-sigil-curse" picking-mode="Ignore" />
     <ui:VisualElement class="tw-medallion" picking-mode="Ignore" />
     <ui:VisualElement class="tw-minimap-frame" />
*/

/* ─── Objective sigils (curse / enemy) ────────────────────────────────── */
.tw-sigil {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.tw-sigil-curse {
    background-image: url("project://database/Assets/UI/Vectors/sigil-curse.svg");
}

.tw-sigil-enemy {
    background-image: url("project://database/Assets/UI/Vectors/sigil-enemy.svg");
}

/* ─── Medallion (jade gem diamond + radiating spurs) ──────────────────── */
/* Default = the large 48px form used at the top of the minimap frame.
   .tw-medallion-sm = 30px form used at the other three tips. */
.tw-medallion {
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/UI/Vectors/medallion.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.tw-medallion-sm {
    width: 30px;
    height: 30px;
}

/* ─── Minimap diamond frame ───────────────────────────────────────────── */
/* The big bezeled diamond plate that surrounds the live minimap area.
   Children — the live world surface (Phase 2) and the four .tw-medallion
   ornaments — anchor to the frame's center via position:absolute. */
.tw-minimap-frame {
    position: relative;
    width: 300px;
    height: 300px;
}

.tw-minimap-back {
    position: absolute;
    width: 272px;
    height: 272px;
    left: 50%;
    top: 50%;
    translate: -136px -136px;
    background-image: url("project://database/Assets/UI/Vectors/minimap-diamond.svg");
    -unity-background-scale-mode: scale-to-fit;
}

/* Tip slots — anchor a medallion at each diamond corner of the frame. */
.tw-minimap-tip {
    position: absolute;
    align-items: center;
    justify-content: center;
}

.tw-minimap-tip-top {
    top: -8px;
    left: 50%;
    translate: -24px 0;
    width: 48px;
    height: 48px;
}

.tw-minimap-tip-bottom {
    bottom: -8px;
    left: 50%;
    translate: -15px 0;
    width: 30px;
    height: 30px;
}

.tw-minimap-tip-left {
    left: -8px;
    top: 50%;
    translate: 0 -15px;
    width: 30px;
    height: 30px;
}

.tw-minimap-tip-right {
    right: -8px;
    top: 50%;
    translate: 0 -15px;
    width: 30px;
    height: 30px;
}
