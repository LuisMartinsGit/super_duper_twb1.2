/* _panels.uss
   Panel chrome — the deep-jade plate with silver inlay border.
   Ported from Game HUD/styles.css .rc-plate / .rc-inlay (lines ~660-720)
   and .sel-frame / .sect-frame.

   USS limitations vs CSS in the mockup (Unity 6):
     - No clip-path: polygon       → border-radius for Phase 0; chamfered
                                      9-slice SVG plate replaces this in Phase 1.
     - No linear-gradient value    → solid background-color for Phase 0;
                                      gradient via SVG plate or two-layer
                                      Texture2D in Phase 1.
     - No box-shadow (inset)       → border-color approximation; full
                                      inset shadow stays absent.
     - No radial-gradient          → flat color now; SVG plate later.
     - No ::before / ::after       → real child VisualElements instead.
   Class prefix: tw- (Waning Border). */

/* ─── Root canvas ─────────────────────────────────────────────────────── */
/* No background-color — the in-match HUD must let the 3D scene show through.
   Individual panels are opaque; everything else is transparent. The previous
   `background-color: var(--tw-bg)` was correct only for the Phase 0 demo. */
.tw-root {
    flex-grow: 1;
    color: var(--tw-text);
}

/* ─── Base panel ──────────────────────────────────────────────────────── */
.tw-panel {
    background-color: var(--tw-base);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay-shadow);
    border-right-color: var(--tw-inlay-shadow);
    border-top-color: var(--tw-inlay-shadow);
    border-bottom-color: var(--tw-inlay-shadow);
    border-top-left-radius: var(--tw-radius-lg);
    border-top-right-radius: var(--tw-radius-lg);
    border-bottom-left-radius: var(--tw-radius-lg);
    border-bottom-right-radius: var(--tw-radius-lg);
    padding-left: var(--tw-pad-panel-x);
    padding-right: var(--tw-pad-panel-x);
    padding-top: var(--tw-pad-panel-y);
    padding-bottom: var(--tw-pad-panel-y);
    color: var(--tw-text);
}

.tw-panel-tight {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.tw-panel-loose {
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 18px;
    padding-bottom: 18px;
}

/* Inner silver hairline — floats 6px inside the panel. */
.tw-panel-inlay {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay);
    border-right-color: var(--tw-inlay);
    border-top-color: var(--tw-inlay);
    border-bottom-color: var(--tw-inlay);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    opacity: 0.45;
}

/* ─── Typography classes ──────────────────────────────────────────────── */
.tw-eyebrow {
    font-size: var(--tw-font-eyebrow);
    color: var(--tw-text-dim);
    letter-spacing: var(--tw-letter-xwide);
    -unity-font-style: bold;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}

.tw-eyebrow-rule {
    height: 1px;
    background-color: var(--tw-inlay);
    opacity: 0.4;
    margin-bottom: 6px;
}

.tw-title {
    font-size: var(--tw-font-title);
    color: var(--tw-accent);
    -unity-font-style: bold;
    letter-spacing: var(--tw-letter-wide);
}

.tw-label {
    font-size: var(--tw-font-label);
    color: var(--tw-text);
    letter-spacing: var(--tw-letter-tight);
}

.tw-value {
    font-size: var(--tw-font-value);
    color: var(--tw-text);
    -unity-font-style: bold;
    letter-spacing: var(--tw-letter-tight);
    -unity-text-align: middle-right;
}

.tw-value-rate {
    font-size: 10px;
    color: var(--tw-accent);
    -unity-font-style: italic;
}

/* ─── Empty selection placeholder ─────────────────────────────────────── */
.tw-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.tw-empty-title {
    font-size: var(--tw-font-label);
    color: var(--tw-text-dim);
    letter-spacing: var(--tw-letter-xwide);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.tw-empty-hint {
    font-size: 12px;
    color: var(--tw-text-dim);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    max-width: 180px;
    white-space: normal;
}

/* ─── Pip (objective progress diamond) ────────────────────────────────── */
.tw-pip {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay-dim);
    border-right-color: var(--tw-inlay-dim);
    border-top-color: var(--tw-inlay-dim);
    border-bottom-color: var(--tw-inlay-dim);
    margin-left: 3px;
    margin-right: 3px;
}

.tw-pip-on {
    background-color: var(--tw-accent);
    border-left-color: var(--tw-accent);
    border-right-color: var(--tw-accent);
    border-top-color: var(--tw-accent);
    border-bottom-color: var(--tw-accent);
}

/* ─── Modal overlay ───────────────────────────────────────────────────── */
/* Full-screen dim backdrop. picking-mode: Position (default) blocks world
   clicks while the popup is shown. */
.tw-modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.tw-modal-panel {
    width: 620px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 18px;
}

/* ─── Culture-choice popup ────────────────────────────────────────────── */
.tw-culture-col {
    width: 170px;
    align-items: center;
}

.tw-culture-swatches {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.tw-culture-swatch {
    width: 36px;
    height: 36px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: var(--tw-base);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay);
    border-right-color: var(--tw-inlay);
    border-top-color: var(--tw-inlay);
    border-bottom-color: var(--tw-inlay);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.tw-culture-name {
    font-size: 14px;
    color: var(--tw-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.tw-culture-desc {
    font-size: 11px;
    color: var(--tw-text-dim);
    -unity-text-align: upper-center;
    white-space: normal;
    min-height: 64px;
    margin-bottom: 8px;
}

.tw-culture-choose {
    min-width: 110px;
    max-width: 140px;
    margin-top: 4px;
}

/* ─── Training queue slot (28×28 square) ──────────────────────────────── */
/* Five of these sit in the selection panel below the training progress bar.
   Empty by default (dim border); filled slots show a unit-id label and a
   gold border. The currently-training unit is the FIRST slot. */
.tw-train-slot {
    width: 28px;
    height: 28px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: var(--tw-base-edge);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay-dim);
    border-right-color: var(--tw-inlay-dim);
    border-top-color: var(--tw-inlay-dim);
    border-bottom-color: var(--tw-inlay-dim);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    align-items: center;
    justify-content: center;
}

.tw-train-slot-filled {
    background-color: var(--tw-base-mid);
    border-left-color: var(--tw-accent);
    border-right-color: var(--tw-accent);
    border-top-color: var(--tw-accent);
    border-bottom-color: var(--tw-accent);
}

.tw-train-slot-label {
    color: var(--tw-text);
    font-size: 8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
    letter-spacing: 1px;
}

/* ─── Selection panel widgets (HP bar, multi-count, desc) ─────────────── */
/* Unity 6 fails to resolve `var()` inside inline `style=""` attributes during
   UXML cloning (the stylesheet cascade isn't applied yet at that point).
   These classes own the variable references so callers can stay class-only. */
.tw-hp-track {
    height: 8px;
    background-color: var(--tw-base-edge);
    margin-left: 6px;
    margin-right: 6px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.tw-hp-fill {
    height: 100%;
    width: 0%;
    background-color: var(--tw-accent);
}

.tw-desc {
    margin-top: 8px;
    font-size: 11px;
    color: var(--tw-text-dim);
    white-space: normal;
}

.tw-multi-count {
    font-size: 24px;
    color: var(--tw-accent);
    -unity-font-style: bold;
    margin-top: 8px;
    letter-spacing: 2px;
}

/* ─── Row helpers ─────────────────────────────────────────────────────── */
.tw-row {
    flex-direction: row;
    align-items: center;
}

.tw-col {
    flex-direction: column;
}

.tw-grow {
    flex-grow: 1;
}
