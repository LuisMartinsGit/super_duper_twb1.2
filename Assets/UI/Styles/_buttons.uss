/* _buttons.uss
   Selection-stage button + top-left menu button.
   Ported from Game HUD/styles.css .sel-btn (line ~1313) and .hud-menu-btn
   (line ~1032).

   IMPORTANT: USS in Unity 6 does NOT parse `linear-gradient(...)` as a
   background-image value, so all gradient effects are deferred to Phase 1's
   SVG plates. Buttons are styled as solid-color VisualElement containers
   wrapping a Label — using `ui:Button` re-introduces Unity's runtime default
   theme rendering on top of these classes. */

/* ─── Selection-stage button ──────────────────────────────────────────── */
.tw-btn {
    position: relative;
    background-color: var(--tw-base);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay-shadow);
    border-right-color: var(--tw-inlay-shadow);
    border-top-color: var(--tw-inlay-shadow);
    border-bottom-color: var(--tw-inlay-shadow);
    border-top-left-radius: var(--tw-radius-md);
    border-top-right-radius: var(--tw-radius-md);
    border-bottom-left-radius: var(--tw-radius-md);
    border-bottom-right-radius: var(--tw-radius-md);
    padding-left: 24px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    min-width: 150px;
    max-width: 220px;
    flex-direction: row;
    align-items: center;
    transition-property: scale, border-color;
    transition-duration: 120ms;
}

.tw-btn-label {
    color: var(--tw-text);
    font-size: var(--tw-font-label);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: var(--tw-letter-wide);
    white-space: normal;
    flex-grow: 1;
    transition-property: color;
    transition-duration: 120ms;
}

.tw-btn:hover {
    border-left-color: var(--tw-accent-soft);
    border-right-color: var(--tw-accent-soft);
    border-top-color: var(--tw-accent-soft);
    border-bottom-color: var(--tw-accent-soft);
    scale: 1.01 1.01;
}

.tw-btn:hover .tw-btn-label {
    color: var(--tw-accent);
}

.tw-btn:active {
    scale: 0.99 0.99;
}

.tw-btn-on {
    border-left-color: var(--tw-accent);
    border-right-color: var(--tw-accent);
    border-top-color: var(--tw-accent);
    border-bottom-color: var(--tw-accent);
}

.tw-btn-on .tw-btn-label {
    color: var(--tw-accent);
}

/* Tick (rotated 6×6 diamond) at the left of each selection button. */
.tw-btn-tick {
    position: absolute;
    left: 10px;
    top: 50%;
    width: 6px;
    height: 6px;
    rotate: 45deg;
    translate: 0 -3px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay);
    border-right-color: var(--tw-inlay);
    border-top-color: var(--tw-inlay);
    border-bottom-color: var(--tw-inlay);
    transition-property: background-color, border-color;
    transition-duration: 120ms;
}

.tw-btn:hover .tw-btn-tick,
.tw-btn-on .tw-btn-tick {
    background-color: var(--tw-accent);
    border-left-color: var(--tw-accent);
    border-right-color: var(--tw-accent);
    border-top-color: var(--tw-accent);
    border-bottom-color: var(--tw-accent);
}

/* ─── Action-grid button (square, fits inside the actions panel grid) ── */
.tw-action-btn {
    width: 48px;
    height: 48px;
    margin: 3px;
    padding: 4px;
    background-color: var(--tw-base);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay-shadow);
    border-right-color: var(--tw-inlay-shadow);
    border-top-color: var(--tw-inlay-shadow);
    border-bottom-color: var(--tw-inlay-shadow);
    border-top-left-radius: var(--tw-radius-sm);
    border-top-right-radius: var(--tw-radius-sm);
    border-bottom-left-radius: var(--tw-radius-sm);
    border-bottom-right-radius: var(--tw-radius-sm);
    align-items: center;
    justify-content: center;
    transition-property: scale, border-color;
    transition-duration: 120ms;
}

.tw-action-btn:hover {
    border-left-color: var(--tw-accent-soft);
    border-right-color: var(--tw-accent-soft);
    border-top-color: var(--tw-accent-soft);
    border-bottom-color: var(--tw-accent-soft);
    scale: 1.04 1.04;
}

.tw-action-btn:active {
    scale: 0.98 0.98;
}

.tw-action-btn-disabled {
    opacity: 0.45;
}

.tw-action-btn-label {
    color: var(--tw-text);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
}

.tw-action-btn:hover .tw-action-btn-label {
    color: var(--tw-accent);
}

/* ─── Top-left MENU button ────────────────────────────────────────────── */
.tw-menu-btn {
    background-color: var(--tw-base);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--tw-inlay-shadow);
    border-right-color: var(--tw-inlay-shadow);
    border-top-color: var(--tw-inlay-shadow);
    border-bottom-color: var(--tw-inlay-shadow);
    border-top-left-radius: var(--tw-radius-md);
    border-top-right-radius: var(--tw-radius-md);
    border-bottom-left-radius: var(--tw-radius-md);
    border-bottom-right-radius: var(--tw-radius-md);
    padding-left: 16px;
    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 10px;
    width: 110px;
    height: 36px;
    align-items: center;
    justify-content: center;
    transition-property: scale, border-color;
    transition-duration: 120ms;
}

.tw-menu-btn-label {
    color: var(--tw-accent);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    -unity-text-align: middle-center;
    transition-property: color;
    transition-duration: 120ms;
}

.tw-menu-btn:hover {
    border-left-color: var(--tw-accent-soft);
    border-right-color: var(--tw-accent-soft);
    border-top-color: var(--tw-accent-soft);
    border-bottom-color: var(--tw-accent-soft);
    scale: 1.02 1.02;
}

.tw-menu-btn:hover .tw-menu-btn-label {
    color: var(--tw-text);
}
