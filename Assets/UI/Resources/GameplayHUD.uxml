<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="False">

    <Style src="project://database/Assets/UI/Styles/_tokens.uss" />
    <Style src="project://database/Assets/UI/Styles/_panels.uss" />
    <Style src="project://database/Assets/UI/Styles/_buttons.uss" />
    <Style src="project://database/Assets/UI/Styles/_filigree.uss" />
    <Style src="project://database/Assets/UI/Styles/_widgets.uss" />

    <ui:VisualElement name="root" class="tw-root tw-theme-jade"
                      style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"
                      picking-mode="Ignore">

        <!-- Top-left: MENU button (Phase 2b will wire onClick) -->
        <ui:VisualElement name="menu-btn" class="tw-menu-btn"
                          style="position: absolute; left: 24px; top: 24px;">
            <ui:Label text="MENU" class="tw-menu-btn-label" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Top-left objectives panel — Phase 2b live binding -->
        <ui:VisualElement name="objectives" class="tw-panel"
                          style="position: absolute; left: 24px; top: 88px; width: 240px;">
            <ui:VisualElement class="tw-corner tw-corner-tl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-tr" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-bl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-br" picking-mode="Ignore" />
            <ui:Label text="OBJECTIVES" class="tw-eyebrow" />
            <ui:VisualElement class="tw-eyebrow-rule" />

            <ui:VisualElement class="tw-row" style="margin-top: 4px;">
                <ui:VisualElement class="tw-sigil tw-sigil-curse"
                                  picking-mode="Ignore"
                                  style="margin-right: 6px;" />
                <ui:Label name="obj-nodes-label" text="Cleanse nodes" class="tw-label tw-grow" />
                <ui:VisualElement name="obj-nodes-pips" class="tw-row" />
                <ui:Label name="obj-nodes-count" text="0/0" class="tw-value"
                          style="font-size: 12px; min-width: 32px; margin-left: 6px;" />
            </ui:VisualElement>

            <ui:VisualElement class="tw-row" style="margin-top: 6px;">
                <ui:VisualElement class="tw-sigil tw-sigil-enemy"
                                  picking-mode="Ignore"
                                  style="margin-right: 6px;" />
                <ui:Label text="Defeat players" class="tw-label tw-grow" />
                <ui:Label name="obj-players-count" text="0/3" class="tw-value"
                          style="font-size: 12px; min-width: 32px; margin-left: 6px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom row — resources + selection + actions in one flex container.
             `align-items: stretch` makes selection and actions auto-match the
             content-driven height of resources (the tallest sibling), without
             us having to hard-code a height that drifts when resources grow. -->
        <ui:VisualElement name="bottom-row"
                          style="position: absolute; left: 24px; bottom: 24px;
                                 flex-direction: row; align-items: stretch;">

        <!-- Bottom-left resources panel — LIVE in Phase 2a -->
        <ui:VisualElement name="resources" class="tw-panel"
                          style="width: 240px;">
            <ui:VisualElement class="tw-corner tw-corner-tl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-tr" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-bl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-br" picking-mode="Ignore" />
            <ui:VisualElement class="tw-edge tw-edge-top" picking-mode="Ignore" />

            <ui:Label text="RESOURCES" class="tw-eyebrow" />
            <ui:VisualElement class="tw-eyebrow-rule" />

            <ui:VisualElement class="tw-row">
                <ui:Label text="Population" class="tw-label tw-grow" />
                <ui:Label name="population-value" text="0/0" class="tw-value" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-row">
                <ui:Label text="Religion" class="tw-label tw-grow" />
                <ui:Label name="religion-value" text="0" class="tw-value" />
            </ui:VisualElement>

            <ui:VisualElement class="tw-divider">
                <ui:VisualElement class="tw-divider-line" />
                <ui:VisualElement class="tw-divider-gem" />
                <ui:VisualElement class="tw-divider-line" />
            </ui:VisualElement>

            <ui:VisualElement class="tw-row">
                <ui:Label text="Supplies" class="tw-label tw-grow" />
                <ui:Label name="supplies-value" text="0" class="tw-value" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-row">
                <ui:Label text="Iron" class="tw-label tw-grow" />
                <ui:Label name="iron-value" text="0" class="tw-value" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-row">
                <ui:Label text="Crystal" class="tw-label tw-grow" />
                <ui:Label name="crystal-value" text="0" class="tw-value" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-row">
                <ui:Label text="Veilsteel" class="tw-label tw-grow" />
                <ui:Label name="veilsteel-value" text="0" class="tw-value" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-row">
                <ui:Label text="Glow" class="tw-label tw-grow" />
                <ui:Label name="glow-value" text="0" class="tw-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Selection panel — square, height auto-matched to resources by the
             flex-stretch row wrapper. Width chosen to be square-ish against
             the resources panel's content-driven height. -->
        <ui:VisualElement name="selection-panel" class="tw-panel"
                          style="width: 240px; margin-left: 16px;">
            <ui:VisualElement class="tw-corner tw-corner-tl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-tr" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-bl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-br" picking-mode="Ignore" />

            <!-- Empty state — visible when nothing selected -->
            <ui:VisualElement name="sel-empty" class="tw-empty">
                <ui:Label text="NO SELECTION" class="tw-empty-title" />
                <ui:Label text="Choose a target from the world" class="tw-empty-hint" />
            </ui:VisualElement>

            <!-- Single entity state -->
            <ui:VisualElement name="sel-single" style="display: none; flex-grow: 1;">
                <ui:Label name="sel-name" text="--" class="tw-title" />
                <ui:Label name="sel-type" text="--" class="tw-eyebrow"
                          style="margin-top: 2px;" />
                <ui:VisualElement class="tw-eyebrow-rule" style="margin-top: 6px; margin-bottom: 6px;" />

                <!-- HP row -->
                <ui:VisualElement name="sel-hp-row" class="tw-row" style="margin-top: 4px;">
                    <ui:Label text="HP" class="tw-label" style="min-width: 32px;" />
                    <ui:VisualElement class="tw-grow tw-hp-track">
                        <ui:VisualElement name="sel-hp-fill" class="tw-hp-fill"
                                          picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="sel-hp-text" text="--/--" class="tw-value"
                              style="font-size: 12px; min-width: 64px;" />
                </ui:VisualElement>

                <!-- Combat stats row -->
                <ui:VisualElement name="sel-stats-row" class="tw-row"
                                  style="margin-top: 12px; justify-content: space-around;">
                    <ui:VisualElement class="tw-col" style="align-items: center; flex-grow: 1;">
                        <ui:Label text="ATK" class="tw-eyebrow" />
                        <ui:Label name="sel-atk" text="--" class="tw-value"
                                  style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tw-col" style="align-items: center; flex-grow: 1;">
                        <ui:Label text="DEF" class="tw-eyebrow" />
                        <ui:Label name="sel-def" text="--" class="tw-value"
                                  style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tw-col" style="align-items: center; flex-grow: 1;">
                        <ui:Label text="SPD" class="tw-eyebrow" />
                        <ui:Label name="sel-spd" text="--" class="tw-value"
                                  style="font-size: 14px;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Description / extra info -->
                <ui:Label name="sel-desc" text="" class="tw-desc" />

                <!-- Training progress (only visible for training buildings).
                     Current unit + remaining time + progress bar + 5 queue slots. -->
                <ui:VisualElement name="sel-training" style="display: none; margin-top: 10px;">
                    <ui:Label text="TRAINING" class="tw-eyebrow" />
                    <ui:VisualElement class="tw-row" style="margin-top: 2px;">
                        <ui:Label name="sel-train-current" text="--" class="tw-label tw-grow" />
                        <ui:Label name="sel-train-time" text="--" class="tw-value"
                                  style="font-size: 11px; min-width: 40px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tw-hp-track" style="margin-top: 4px;">
                        <ui:VisualElement name="sel-train-fill" class="tw-hp-fill"
                                          picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="sel-train-slots" class="tw-row"
                                      style="margin-top: 6px; justify-content: flex-start;">
                        <ui:VisualElement name="sel-train-slot-0" class="tw-train-slot">
                            <ui:Label class="tw-train-slot-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="sel-train-slot-1" class="tw-train-slot">
                            <ui:Label class="tw-train-slot-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="sel-train-slot-2" class="tw-train-slot">
                            <ui:Label class="tw-train-slot-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="sel-train-slot-3" class="tw-train-slot">
                            <ui:Label class="tw-train-slot-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="sel-train-slot-4" class="tw-train-slot">
                            <ui:Label class="tw-train-slot-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Multi-entity state -->
            <ui:VisualElement name="sel-multi" style="display: none; flex-grow: 1;
                                                       align-items: center; justify-content: center;">
                <ui:Label text="MULTIPLE SELECTED" class="tw-eyebrow" />
                <ui:Label name="sel-multi-count" text="0 units" class="tw-multi-count" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Actions panel — square, height auto-matched to resources by the
             flex-stretch row wrapper. Populated by ActionPanelRegion based on
             the selected entity's ActionType (BuildingPlacement, UnitTraining,
             etc.). Empty state when nothing actionable is selected. -->
        <ui:VisualElement name="actions-panel" class="tw-panel"
                          style="width: 240px; margin-left: 16px;">
            <ui:VisualElement class="tw-corner tw-corner-tl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-tr" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-bl" picking-mode="Ignore" />
            <ui:VisualElement class="tw-corner tw-corner-br" picking-mode="Ignore" />

            <ui:Label name="actions-title" text="ACTIONS" class="tw-eyebrow" />
            <ui:VisualElement class="tw-eyebrow-rule" />

            <!-- Empty state -->
            <ui:VisualElement name="actions-empty" class="tw-empty">
                <ui:Label text="NO ACTIONS" class="tw-empty-title" />
                <ui:Label text="Select your own unit or building"
                          class="tw-empty-hint" />
            </ui:VisualElement>

            <!-- Button grid — ActionPanelRegion populates this at runtime -->
            <ui:VisualElement name="actions-grid"
                              style="display: none; flex-direction: row;
                                     flex-wrap: wrap; margin-top: 6px;" />
        </ui:VisualElement>

        </ui:VisualElement>
        <!-- end bottom-row -->

        <!-- Bottom-right minimap (Phase 2c: live minimap surface) -->
        <ui:VisualElement name="minimap" class="tw-minimap-frame"
                          style="position: absolute; right: 24px; bottom: 24px;">
            <ui:VisualElement class="tw-minimap-back" picking-mode="Ignore" />
            <ui:VisualElement class="tw-minimap-tip tw-minimap-tip-top" picking-mode="Ignore">
                <ui:VisualElement class="tw-medallion" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-minimap-tip tw-minimap-tip-right" picking-mode="Ignore">
                <ui:VisualElement class="tw-medallion tw-medallion-sm" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-minimap-tip tw-minimap-tip-bottom" picking-mode="Ignore">
                <ui:VisualElement class="tw-medallion tw-medallion-sm" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-minimap-tip tw-minimap-tip-left" picking-mode="Ignore">
                <ui:VisualElement class="tw-medallion tw-medallion-sm" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Culture-choice modal popup — Phase 3e.
             Last child = top z-order. Hidden until CulturePopupRegion sees
             CultureChoicePopup.IsVisible == true. The dim backdrop fills the
             screen and has picking-mode: Position so it blocks all world clicks. -->
        <ui:VisualElement name="culture-popup" class="tw-modal-backdrop"
                          style="display: none;">
            <ui:VisualElement class="tw-panel tw-modal-panel">
                <ui:VisualElement class="tw-corner tw-corner-tl" picking-mode="Ignore" />
                <ui:VisualElement class="tw-corner tw-corner-tr" picking-mode="Ignore" />
                <ui:VisualElement class="tw-corner tw-corner-bl" picking-mode="Ignore" />
                <ui:VisualElement class="tw-corner tw-corner-br" picking-mode="Ignore" />
                <ui:VisualElement class="tw-edge tw-edge-top" picking-mode="Ignore" />

                <ui:Label text="ADVANCE TO ERA 2" class="tw-title"
                          style="-unity-text-align: middle-center;" />
                <ui:Label name="culture-cost" text="Cost: --" class="tw-eyebrow"
                          style="-unity-text-align: middle-center; margin-top: 4px;" />
                <ui:VisualElement class="tw-eyebrow-rule"
                                  style="margin-top: 10px; margin-bottom: 10px;" />
                <ui:Label text="Choose your cultural specialization"
                          class="tw-empty-hint"
                          style="-unity-text-align: middle-center; margin-bottom: 12px;" />

                <ui:VisualElement style="flex-direction: row; justify-content: space-around;">
                    <!-- Alanthor -->
                    <ui:VisualElement name="culture-col-alanthor" class="tw-culture-col">
                        <ui:VisualElement class="tw-culture-swatches">
                            <ui:VisualElement name="culture-alanthor-primary"
                                              class="tw-culture-swatch" picking-mode="Ignore" />
                            <ui:VisualElement name="culture-alanthor-secondary"
                                              class="tw-culture-swatch" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="culture-alanthor-name" text="--" class="tw-culture-name" />
                        <ui:Label name="culture-alanthor-desc" text="--" class="tw-culture-desc" />
                        <ui:VisualElement name="culture-alanthor-choose" class="tw-btn tw-culture-choose">
                            <ui:Label text="CHOOSE" class="tw-btn-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Feraldis -->
                    <ui:VisualElement name="culture-col-feraldis" class="tw-culture-col">
                        <ui:VisualElement class="tw-culture-swatches">
                            <ui:VisualElement name="culture-feraldis-primary"
                                              class="tw-culture-swatch" picking-mode="Ignore" />
                            <ui:VisualElement name="culture-feraldis-secondary"
                                              class="tw-culture-swatch" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="culture-feraldis-name" text="--" class="tw-culture-name" />
                        <ui:Label name="culture-feraldis-desc" text="--" class="tw-culture-desc" />
                        <ui:VisualElement name="culture-feraldis-choose" class="tw-btn tw-culture-choose">
                            <ui:Label text="CHOOSE" class="tw-btn-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Runai -->
                    <ui:VisualElement name="culture-col-runai" class="tw-culture-col">
                        <ui:VisualElement class="tw-culture-swatches">
                            <ui:VisualElement name="culture-runai-primary"
                                              class="tw-culture-swatch" picking-mode="Ignore" />
                            <ui:VisualElement name="culture-runai-secondary"
                                              class="tw-culture-swatch" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="culture-runai-name" text="--" class="tw-culture-name" />
                        <ui:Label name="culture-runai-desc" text="--" class="tw-culture-desc" />
                        <ui:VisualElement name="culture-runai-choose" class="tw-btn tw-culture-choose">
                            <ui:Label text="CHOOSE" class="tw-btn-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement style="flex-direction: row; justify-content: center; margin-top: 14px;">
                    <ui:VisualElement name="culture-cancel" class="tw-btn">
                        <ui:Label text="CANCEL" class="tw-btn-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
