{
  "name": "twb-hud-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "React/CSS HUD for The Waning Border, rendered into Unity via CEF (UnityWebBrowser).",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('../Assets/StreamingAssets/HUD',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
